# SPDX-License-Identifier: Apache-2.0
#
# Public frontend configuration. All values here are public (RPC URL, chain id,
# deployed contract addresses). No private keys, ever.
# Copy to .env.local and fill in the deployed addresses.

NEXT_PUBLIC_HEDERA_CHAIN_ID="296"
NEXT_PUBLIC_HEDERA_RPC_URL="https://testnet.hashio.io/api"
NEXT_PUBLIC_HEDERA_RPC_FALLBACK_URLS=""
NEXT_PUBLIC_MARKET_ID="bond-usdc-q3"
NEXT_PUBLIC_TOKEN_DECIMALS="18"
NEXT_PUBLIC_YIELD_SOURCE_KIND="bond"
NEXT_PUBLIC_YIELD_SOURCE_NAME="Tokenized bond"
NEXT_PUBLIC_YIELD_SOURCE_URL=""
NEXT_PUBLIC_BOND_ADDRESS=""
NEXT_PUBLIC_STRATEGY_ADDRESS=""
NEXT_PUBLIC_UNDERLYING_ADDRESS=""

# Testnet cash faucet. sdUSD has no public mint, so the faucet is server-side:
# the /api/faucet route uses FAUCET_PRIVATE_KEY to grant ATS KYC and transfer
# test cash plus a little HBAR for gas. Never use a mainnet key here.
# NEXT_PUBLIC_FAUCET_ENABLED shows the button; AMOUNT is in whole tokens.
NEXT_PUBLIC_FAUCET_ENABLED=""
NEXT_PUBLIC_FAUCET_AMOUNT="1000"
FAUCET_PRIVATE_KEY=""
FAUCET_CASH_AMOUNT="1000"
FAUCET_HBAR_AMOUNT="20"

NEXT_PUBLIC_SY_ADDRESS=""
NEXT_PUBLIC_PT_ADDRESS=""
NEXT_PUBLIC_YT_ADDRESS=""
NEXT_PUBLIC_TOKENIZER_ADDRESS=""
NEXT_PUBLIC_MARKET_ADDRESS=""
NEXT_PUBLIC_ORDERBOOK_ADDRESS=""

# Privy embedded wallets. Set NEXT_PUBLIC_PRIVY_APP_ID from dashboard.privy.io to
# enable email wallets across the working app; leave it blank to keep the injected
# wallet path only. PRIVY_APP_SECRET is server-only and used to verify identity
# access tokens before funding a wallet.
NEXT_PUBLIC_PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# Optional bounded server signer. The signer and policy IDs are public. The
# P-256 private key is server-only. The policy must independently enforce the
# same PT cap, chain, contract, function and zero-value conditions.
NEXT_PUBLIC_PRIVY_DELEGATED_SIGNER_ID=""
NEXT_PUBLIC_PRIVY_DELEGATED_POLICY_ID=""
NEXT_PUBLIC_PRIVY_DELEGATED_MAX_PT="10"
PRIVY_AUTHORIZATION_PRIVATE_KEY=""

# Private-access form. The site key is public but is read only by the Vercel
# server page; the API token must be the same random secret stored on the
# Cloudflare Worker. Never prefix either secret with NEXT_PUBLIC_*.
TURNSTILE_SITE_KEY=""
ACCESS_REQUEST_API_URL="https://sidereal-access-requests.<account>.workers.dev"
ACCESS_REQUEST_API_TOKEN=""

# Hosted demo runner configuration for production Vercel.
# DEMO_RUNNER_API_URL points to the Render Docker service, for example:
# https://sidereal-demo-runner.onrender.com
DEMO_RUNNER_API_URL=""
DEMO_RUNNER_TOKEN=""

# NOTE: every NEXT_PUBLIC_* value above is inlined into the browser bundle by
# `next build`. Setting them as Cloudflare Worker or Vercel runtime variables
# does nothing for the client — reconfiguring a deployed frontend requires a
# rebuild. Generate this file from a deployment manifest instead of editing it
# by hand:  pnpm gen:env ../../contracts/deployments/hedera-testnet.json

# Dedicated, funded testnet faucet account with ATS demo-eligibility authority.
# Do not use a production issuer key. Never expose these values in NEXT_PUBLIC_*.
# Durable Cloudflare D1 faucet allocation ledger (also works from Vercel).
CLOUDFLARE_ACCOUNT_ID=""
FAUCET_D1_DATABASE_ID=""
FAUCET_D1_API_TOKEN=""
