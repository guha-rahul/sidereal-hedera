{
  "$schema": "web/app/node_modules/wrangler/config-schema.json",
  "name": "sidereal-hedera",
  "main": "web/app/.open-next/worker.js",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "build": {
    "cwd": "web/app",
    "command": "npx --yes pnpm@10.34.5 install --frozen-lockfile && npx --yes pnpm@10.34.5 run cf:build"
  },
  "assets": {
    "directory": "web/app/.open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sidereal-hedera"
    }
  ]
}
