# Hedera testnet only. Never put a mainnet or real-value key in this file.
# Copy to .env (git-ignored) and fill in. Keys stay out of the repo and out of
# chat messages; only addresses and transaction hashes are shareable evidence.

# --- Required for any broadcast -------------------------------------------
# Funded Hedera testnet ECDSA key, from https://portal.hedera.com (0x-prefixed).
PRIVATE_KEY=0x<issuer-testnet-ecdsa-key>
# Hedera testnet JSON-RPC relay.
HEDERA_RPC_URL=https://testnet.hashio.io/api

# --- script/DeployATS.s.sol: issues the ATS bond and the whole market -----
# Second funded account, distinct from the issuer. The demo must show two wallets.
BUYER_ADDRESS=0x<buyer-evm-address>
# Where the deployment manifest is written. Committed as submission evidence.
MANIFEST_PATH=deployments/hedera-ats.json
# Lifecycle timing, in seconds. Defaults: 90 days term, 1 hour record delay,
# 60 second start delay. The ATS bond init reverts WrongTimestamp unless the
# starting date is strictly in the future, so START_DELAY_SECONDS must be >= 1;
# keep it well above one block of broadcast latency. RECORD_DELAY_SECONDS must
# exceed START_DELAY_SECONDS, and TERM_SECONDS must exceed
# RECORD_DELAY_SECONDS + 300 (the coupon payment date sits 300s after the record date).
TERM_SECONDS=7776000
RECORD_DELAY_SECONDS=3600
START_DELAY_SECONDS=60

# --- script/ATSLifecycle.s.sol: one phase per broadcast -------------------
# seed | trade | coupon | revoke | reinstate | settle
# seed/revoke/reinstate need the issuer key; trade needs the buyer key; settle is
# run once per account. Swap PRIVATE_KEY to the buyer's key for those phases.
PHASE=seed

# --- Fork-gated tests -----------------------------------------------------
# Live ATS compatibility and deployment checks are skipped unless this is true.
# They read Hedera testnet at a pinned block and broadcast nothing.
RUN_ATS_LIVE=false

# --- script/Deploy.s.sol: the older market-only deployment ----------------
# Pass the ATS settlement ADAPTER as BOND, never the raw ATS security address.
# CASH_ASSET=0x<cash-erc20>
# BOND=0x<ats-bond-adapter>
# ADMIN=0x<admin-address>
# FEE_RECIPIENT=0x<fee-recipient>
# MATURITY=<unix-seconds, must equal the bond maturity>
# SCALAR_ROOT=1000000000000000000
# ANCHOR=1000000000000000000
# FEE_BPS=10
# TAKER_FEE_BPS=10
# TWAP_WINDOW=1800
# BOND_FUNDING=0
